{
  "meta": {
    "lastTouchedVersion": "2026.6.8"
  },
  "heartbeat": {
    "every": "30m",
    "activeHours": { "start": "08:00", "end": "22:00" }
  },
  "agents": {
    "defaults": {
      "model": "anthropic/claude-sonnet-4-5",
      "memorySearch": { "provider": "openai" }
    },
    "list": [
      { "id": "main", "name": "Main", "default": true },
      { "id": "family", "name": "Family", "model": "codex/gpt-5.5" }
    ]
  },
  "memory": {
    "backend": "qmd"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "123456:fixture-not-a-real-token",
      "dmPolicy": "allowlist",
      "allowFrom": ["123456789"],
      "requireMention": true,
      "streamMode": "partial"
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token", "token": "fixture-gateway-token-0123456789abcdef" }
  }
}
